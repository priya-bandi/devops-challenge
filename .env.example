# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
#   cp .env.example .env && chmod 600 .env

# Image reference (immutable version tag, never "latest")
IMAGE_REPO=eoir-stack
IMAGE_TAG=1.4.2

# PostgreSQL
POSTGRES_USER=c2admin
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=surveillance_c2
